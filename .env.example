# =====================================================================
#  TaskFlow — fichier d'exemple de configuration (.env.example)
#  Copier ce fichier vers .env : cp .env.example .env
# =====================================================================

# ---------- Application ----------
PORT=3000
APP_PORT=3000

# ---------- MongoDB ----------
MONGODB_URI=mongodb://mongo:27017/taskflow
# MONGODB_DB_NAME=taskflow
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_RETRIES=30
MONGODB_CONNECT_RETRY_DELAY_MS=2000
MONGODB_AUTO_INDEX=true

# ---------- Sécurité ----------
# À modifier obligatoirement en environnement de production
JWT_SECRET=change-me-please-secret-key-taskflow-2026
JWT_EXPIRES_IN=8h

# ---------- Données de démonstration ----------
SEED_DEMO=true
